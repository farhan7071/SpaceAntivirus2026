<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Only foundation-level permissions declared in Sprint 003. Every
      permission here maps to a real, already-justified use per Sprint
      002 §3 Feature Strategy and Sprint 002.75 §6 Permission Communication
      Guide. Storage/location/etc. are added feature-by-feature in
      Sprint 004+, each with its matching rationale copy — never
      speculatively, per Sprint 001 Risk #4.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sprint 025: without this, WorkManager's own bundled boot-
         rescheduling component (merged automatically from the
         androidx.work AAR — no custom BroadcastReceiver needed here)
         cannot re-register already-persisted periodic work with the OS
         scheduler after a device reboot. Scheduled background scans
         would otherwise silently stop firing after every reboot until
         the user happens to relaunch the app. Normal protection level —
         no runtime request needed. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Added in Sprint 004B for InstalledApplicationEnumerator
      (core:enumeration). Without this, Android 11+'s package-visibility
      filtering means PackageManager.getInstalledPackages() silently
      returns a reduced subset rather than failing loudly — for a
      security app, silently missing installed apps is worse than an
      explicit error, so this is a deliberate, justified addition, not a
      speculative one. Sprint 001 already found this permission in the
      original app with the same justification (a scanner needs to see
      what's installed); Sprint 002's Data Safety re-audit note applies
      here too — this must be declared in the Play Console Data Safety
      form when this feature ships.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".SpaceAntivirusApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SpaceAntivirus"
        android:supportsRtl="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <!--
          Sprint 044. The Mobile Ads SDK throws at initialisation if this
          meta-data is absent, so it is required even in a build that
          never serves an ad.

          The value is Google's published SAMPLE app ID, which is the
          correct default: it is permanently available, serves only test
          ads, and generates no revenue and no invalid traffic. Shipping
          a LIVE app ID in a debug build is what gets AdMob accounts
          suspended, so the safe value is the default and the live value
          is a deliberate release step. Replace with the real ZX Force
          Soft app ID before release — see docs/ads.md.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SpaceAntivirus.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Sprint 026.1 hotfix — root cause of the real-device
          NoSuchMethodException on ScanWorker's <init>(Context, WorkerParameters):
          WorkManager's default ContentProvider-based auto-initializer
          (androidx.startup) runs during ContentProvider.onCreate(), which
          the Android platform always executes BEFORE Application.onCreate()
          — and therefore before Hilt has field-injected
          SpaceAntivirusApp.workerFactory. Reading Configuration.Provider's
          workManagerConfiguration that early is not guaranteed to see a
          correctly-initialized HiltWorkerFactory, so WorkManager silently
          falls back to its own default, non-Hilt-aware WorkerFactory —
          which only knows how to construct a Worker via the plain
          2-argument (Context, WorkerParameters) constructor. ScanWorker's
          real constructor also takes RunScanRequestUseCase, so reflection
          fails with exactly the reported NoSuchMethodException. This is
          not an Android-9-specific platform behavior — ContentProvider-
          before-Application ordering is constant across API levels — it
          was simply the first device this was exercised on.

          This <meta-data> override disables that default initializer.
          SpaceAntivirusApp now calls WorkManager.initialize(...) manually
          from Application.onCreate(), which the Hilt-generated base class
          always calls AFTER field injection completes — guaranteeing
          workerFactory is real before WorkManager ever touches it. This
          is the documented, standard fix for this exact Hilt+WorkManager
          integration pattern, not a workaround.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          Sprint 042. Restores the ongoing protection notification after a
          restart — NOT the scheduled work, which WorkManager already
          reschedules itself (see the RECEIVE_BOOT_COMPLETED comment
          above, Sprint 025). Registering our own receiver to re-enqueue
          would replace a live schedule and reset its interval window.
          android:exported="true" is required: the sender is the system,
          not this app. LOCKED_BOOT_COMPLETED is included so the
          notification returns on direct-boot-aware devices before the
          user unlocks.
        -->
        <receiver
            android:name=".protection.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          NOTE for Sprint 004: real-time protection's foreground service
          goes here with an explicit foregroundServiceType (resolving
          Sprint 001 Risk #2 / Sprint 002 §9's specialUse decision) once
          feature:realtime has real implementation. Declared here as a
          comment, not a placeholder <service>, per the "no temporary
          shortcuts that will need to be rewritten later" rule — an empty
          service tag would itself be a shortcut needing rework.
        -->

    </application>
</manifest>
